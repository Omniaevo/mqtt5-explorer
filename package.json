{
  "name": "mqtt5-explorer",
  "version": "2.0.0",
  "private": false,
  "license": "GPLv3",
  "description": "A simple MQTT client that supports MQTT5 protocol.",
  "homepage": "https://github.com/Omniaevo/mqtt5-explorer",
  "bugs": {
    "url": "https://github.com/Omniaevo/mqtt5-explorer/issues"
  },
  "author": {
    "name": "Omniaevo S.R.L.",
    "email": "software@omniaevo.it",
    "url": "https://www.omniaevo.it"
  },
  "contributors": [
    {
      "name": "Mauro Nonis",
      "email": "mauro.nonis@omniaevo.it"
    },
    {
      "name": "Leonardo Cossutta",
      "email": "leonardo.cossutta@omniaevo.it"
    }
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:win": "electron-vite build && electron-builder --win",
    "electron:icons": "electron-icon-builder --input=./resources/icon.png --output=build --flatten",
    "lint": "eslint .",
    "postinstall": "electron-builder install-app-deps",
    "postuninstall": "electron-builder install-app-deps",
    "load-test": "node scripts/load-test.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write ."
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "mqtt": "^5.16.0"
  },
  "main": "./out/main/index.js",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdi/font": "^7.1.96",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-icon-builder": "^2.0.1",
    "electron-vite": "^2.3.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "pinia": "^3.0.4",
    "prettier": "^3.9.9",
    "vite": "^5.4.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^3.2.7",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4",
    "vuetify": "^4.2.4"
  }
}
